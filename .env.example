# Copiar a .env y cambiar CAPRI_API_KEY por un secreto propio.
CAPRI_API_KEY=CAMBIA_ESTE_VALOR_DE_EJEMPLO
CAPRI_ENV=dev
# dev: fake (sin red), ollama, cloud o auto; prod: ollama/cloud/auto
CAPRI_ENGINE=fake
CAPRI_MEMORY=local
CAPRI_DATA_DIR=.data
CAPRI_TIMEZONE=America/Mexico_City
CAPRI_LOW_HEART_RATE=60
CAPRI_HTTP_TIMEOUT=30
CAPRI_TIMER_INTERVAL=60

# API de Gemini opcional; sin llave se usa el motor local.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
# Instancia de Ollama existente; no se instala automáticamente.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# Mem0 Platform opcional; sin llave se usa SQLite local.
MEM0_API_KEY=
MEM0_API_URL=https://api.mem0.ai
MEM0_USER_ID=capri-owner

# Fernet (opcional). Sin clave válida: respaldo deshabilitado, nunca plaintext.
CAPRI_BACKUP_KEY=
CAPRI_BACKUP_HOUR=3

# Fase 1: siempre stub, aun si el flag se activa. No llamadas a ElevenLabs.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
